FROM ubuntu:22.04

ARG SPARK_VERSION=3.5.1
ARG HADOOP_VERSION=3
ENV SPARK_HOME=/opt/spark
ENV PATH=${SPARK_HOME}/bin:${PATH}
ENV PYSPARK_PYTHON=/usr/bin/python3
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless wget curl tar python3 python3-pip ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*

# 1. Baixa e extrai o Spark primeiro para criar o diretório /opt/spark
RUN mkdir -p /opt && \
    wget -qO- "https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz" \
    | tar -xz -C /opt && \
    mv /opt/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION} ${SPARK_HOME} && \
    chmod -R a+rX ${SPARK_HOME}

# 2. Insere os JARs do S3/MinIO direto na pasta correta do Spark
RUN mkdir -p ${SPARK_HOME}/jars && \
    wget -q https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar -P ${SPARK_HOME}/jars/ && \
    wget -q https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar -P ${SPARK_HOME}/jars/ && \
    chmod a+r ${SPARK_HOME}/jars/*.jar

RUN python3 -m pip install --no-cache-dir pyspark==${SPARK_VERSION} py4j==0.10.9.7

RUN useradd -m -u 1000 sparkuser || true
RUN chown -R sparkuser:sparkuser ${SPARK_HOME}
USER sparkuser
WORKDIR /opt/spark