version: '3.8'

services:
  postgres:
    image: postgres:13
    environment:
      POSTGRES_USER: airflow
      POSTGRES_PASSWORD: airflow
      POSTGRES_DB: airflow
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U airflow"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7
    ports:
      - "6379:6379"

  airflow-init:
    image: apache/airflow:2.11.0
    user: root
    entrypoint: /bin/bash
    command: -c "apt-get update && apt-get install -y openjdk-17-jre-headless &&
                 /usr/local/bin/python -m pip install --no-cache-dir apache-airflow-providers-apache-spark pyspark==3.5.1 &&
                 airflow db init &&
                 airflow users create \
                   --username admin \
                   --firstname Admin \
                   --lastname User \
                   --role Admin \
                   --email admin@example.com \
                   --password admin"
    environment:
      AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgresql+psycopg2://airflow:airflow@postgres/airflow
      PIP_USER: "false"
    depends_on:
      postgres:
        condition: service_healthy

  airflow-webserver:
    image: apache/airflow:2.11.0
    user: root
    environment:
      AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgresql+psycopg2://airflow:airflow@postgres/airflow
      AIRFLOW__CORE__EXECUTOR: LocalExecutor
      AIRFLOW__CORE__FERNET_KEY: fernet_key
      AIRFLOW__WEBSERVER__SECRET_KEY: "gn672Ad4CF8N6TK"
      AIRFLOW__CORE__DAGS_FOLDER: /opt/airflow/dags
      AIRFLOW__LOGGING__REMOTE_LOGGING: "False"
      PYTHONPATH: "/opt/airflow"
      JAVA_HOME: "/usr/lib/jvm/java-17-openjdk-amd64"
      PIP_USER: "false"
    volumes:
      - ./dags:/opt/airflow/dags
      - ./receita_spark:/opt/airflow/receita_spark
      - ./dados_temp:/opt/airflow/dados_temp
      - ./spark_jobs:/opt/airflow/spark_jobs
      - receita_data:/opt/airflow/data_receita
    ports:
      - "8081:8080"
    command: bash -c "apt-get update && apt-get install -y openjdk-17-jre-headless && /usr/local/bin/python -m pip install --no-cache-dir apache-airflow-providers-apache-spark pyspark==3.5.1 && airflow webserver"

  airflow-scheduler:
    image: apache/airflow:2.11.0
    user: root
    environment:
      AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgresql+psycopg2://airflow:airflow@postgres/airflow
      AIRFLOW__CORE__EXECUTOR: LocalExecutor
      AIRFLOW__CORE__FERNET_KEY: fernet_key
      AIRFLOW__WEBSERVER__SECRET_KEY: "gn672Ad4CF8N6TK"
      AIRFLOW__LOGGING__REMOTE_LOGGING: "False"
      PYTHONPATH: "/opt/airflow"
      JAVA_HOME: "/usr/lib/jvm/java-17-openjdk-amd64"
      PIP_USER: "false"
    volumes:
      - ./dags:/opt/airflow/dags
      - ./receita_spark:/opt/airflow/receita_spark
      - ./dados_temp:/opt/airflow/dados_temp
      - ./spark_jobs:/opt/airflow/spark_jobs
      - receita_data:/opt/airflow/data_receita
    command: bash -c "apt-get update && apt-get install -y openjdk-17-jre-headless && /usr/local/bin/python -m pip install --no-cache-dir apache-airflow-providers-apache-spark pyspark==3.5.1 && airflow scheduler"

  receita-downloader:
    image: python:3.11-slim
    container_name: receita-downloader
    volumes:
      - receita_data:/data
      - ./scripts:/scripts
      - ./dados_temp:/dados_temp
    command: tail -f /dev/null

  spark-master:
    image: bitnamilegacy/spark:3.5.1
    environment:
      - SPARK_MODE=master
    volumes:
      - receita_data:/opt/bitnami/spark/data_receita
      - ./dados_temp:/opt/airflow/dados_temp
    ports:
      - "7077:7077"
      - "8080:8080"

  spark-worker-1:
    image: bitnamilegacy/spark:3.5.1
    environment:
      - SPARK_MODE=worker
      - SPARK_MASTER_URL=spark://spark-master:7077
    volumes:
      - receita_data:/opt/bitnami/spark/data_receita
      - ./dados_temp:/opt/airflow/dados_temp
    depends_on:
      - spark-master

  spark-worker-2:
    image: bitnamilegacy/spark:3.5.1
    environment:
      - SPARK_MODE=worker
      - SPARK_MASTER_URL=spark://spark-master:7077
    volumes:
      - receita_data:/opt/bitnami/spark/data_receita
      - ./dados_temp:/opt/airflow/dados_temp
    depends_on:
      - spark-master

  minio:
    image: minio/minio
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: admin
      MINIO_ROOT_PASSWORD: admin123
    volumes:
      - minio_data:/data
    ports:
      - "9000:9000"
      - "9001:9001"

volumes:
  postgres_data:
  minio_data:
  receita_data: